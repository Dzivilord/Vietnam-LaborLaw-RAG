# Labor Law RAG - local environment template
#
# Copy to .env and fill in only what you need:
#   Copy-Item .env.example .env
#
# The backend loads .env automatically at startup (app/backend/api/main.py).
# Variables already set in the shell take precedence over this file.
#
# Every line below is commented out on purpose. An uncommented but empty
# line (e.g. `OLLAMA_BASE_URL=`) sets the variable to "" and overrides the
# code default. Uncomment a line only when you set a real value.
#
# Never commit .env. Only this template (with no real values) belongs in Git.

# --- Generation: Ollama (default provider in configs/labor_rag.yaml) -------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b

# --- Generation / guardrails: OpenRouter -------------------------------------
# Needed only for generation.provider: openrouter
# or guardrails.classifier.provider: openrouter_jev.
# SECRET:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-chat-latest
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=Labor Law RAG

# --- Generation: Gemini (optional provider) ----------------------------------
# SECRET:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# --- Observability: Logfire (off by default; sends traces off this machine) -
# LOGFIRE_ENABLED=false
# Only needed on machines without a local `logfire projects use` credential.
# SECRET:
# LOGFIRE_TOKEN=

# --- Observability: Firestore trace mirror (off unless collection is set) ---
# FIRESTORE_TRACE_COLLECTION=rag_request_traces
# Path to a service-account JSON stored OUTSIDE this repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\firebase-service-account.json
# Keep false so only a query hash (not the user's question) is mirrored.
# RAG_TRACE_INCLUDE_CONTENT=false

# --- Evals: DeepEval LLM judge (opt-in, calls an external model) ------------
# DEEPEVAL_RUN_LLM_JUDGE=1
# DEEPEVAL_CASES=evals/datasets/generation_cases.jsonl
